# ==============================================================================
# AI-Based Personalized Study Assistant - Environment Configuration
# ==============================================================================

PROJECT_NAME="AI-Based Personalized Study Assistant"
API_V1_STR="/api"

# Database Configuration (SQLite default)
DATABASE_URL="sqlite:///study_assistant.db"

# AI Provider Configuration ('auto', 'openai', 'gemini', 'mock')
# If USE_MOCK_AI is true, the application runs locally without requiring paid API keys!
USE_MOCK_AI=true
AI_PROVIDER=auto

# External API Keys (Optional - only needed if USE_MOCK_AI=false)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Vector Retrieval & Chunking Parameters
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.15
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Adaptive Learning Agent Parameters
MASTERY_DECAY_DAYS=5
WEAK_THRESHOLD=0.50
STRONG_THRESHOLD=0.80
